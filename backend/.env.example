DATABASE_URL="postgresql://quartiere:quartiere@localhost:5433/quartiere?schema=public"

# Supabase Storage (free tier) - persistent photo/video uploads
# Find these in Supabase: Project Settings -> Storage -> S3 Access Keys
SUPABASE_S3_ENDPOINT="https://<project-ref>.supabase.co/storage/v1/s3"
SUPABASE_S3_REGION="us-east-1"
SUPABASE_S3_ACCESS_KEY_ID=""
SUPABASE_S3_SECRET_ACCESS_KEY=""
SUPABASE_BUCKET=""
# Optional - leave empty to auto-generate from the endpoint:
# SUPABASE_PUBLIC_URL="https://<project-ref>.supabase.co/storage/v1/object/public/<bucket>"

# Cloudflare R2 (free tier) - alternative to Supabase
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""

# Admin panel
ADMIN_PASSWORD=""
ADMIN_SECRET=""
